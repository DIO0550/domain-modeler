{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tauri-devcontainer-template",
  "version": "0.1.2",
  "identifier": "io.github.dio0550.domain-modeler",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:14000",
    "beforeDevCommand": "pnpm --dir ../.. --filter @domain-modeler/desktop dev",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @domain-modeler/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "Domain Modeler",
        "width": 800,
        "height": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
