{
  "name": "tauri-devcontainer-template",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @domain-modeler/desktop dev",
    "build": "pnpm --filter @domain-modeler/desktop build",
    "typecheck": "tsc -b",
    "test": "pnpm --filter @domain-modeler/desktop test",
    "test:run": "pnpm --filter @domain-modeler/desktop test:run",
    "test:coverage": "pnpm --filter @domain-modeler/desktop test:coverage",
    "preview": "pnpm --filter @domain-modeler/desktop preview",
    "tauri": "pnpm --filter @domain-modeler/desktop tauri",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check:boundaries": "node ./scripts/check-module-boundaries.mjs",
    "visual:capture": "node ./scripts/storybook-visual-regression.mjs capture",
    "visual:compare": "node ./scripts/storybook-visual-regression.mjs compare"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.20.0",
    "storybook": "^10.6.7",
    "typescript": "~5.8.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "odiff-bin": "4.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "odiff-bin"
    ],
    "overrides": {
      "baseline-browser-mapping": ">=2.11.0",
      "brace-expansion": ">=5.0.12",
      "browserslist": ">=4.28.7",
      "glob": ">=14.0.2",
      "minimatch": ">=11.0.1",
      "source-map-js": ">=1.2.2"
    }
  }
}
